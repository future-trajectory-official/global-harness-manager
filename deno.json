{
  "compilerOptions": {
    "lib": ["deno.window", "deno.ns"]
  },
  "tasks": {
    "test": "deno test -A --parallel",
    "test:cov": "deno test -A --parallel --coverage=cov_profile && deno coverage cov_profile",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check **/*.ts",
    "qa": "deno fmt --check && deno lint && deno check **/*.ts && deno task validate:jsdoc && deno task test",
    "qa:cov": "deno fmt --check && deno lint && deno check **/*.ts && deno task validate:jsdoc && rm -rf cov_profile && deno test -A --parallel --coverage=cov_profile && deno coverage cov_profile",
    "setup-hooks": "deno run -A .agents/skills/bundles/workspace-bundle/setup-harness-env/scripts/setup-hooks.ts",
    "validate-task": "deno run -A .agents/skills/bundles/management-bundle/session-planning/scripts/validate-task.ts --template .agents/management/task-template.md",
    "phase-gate": "deno run -A .agents/core/phase-gate.ts",
    "validate:jsdoc": "deno run -A .agents/core/validate-jsdoc.ts"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "imports": {
    "@std/path": "jsr:@std/path@^1.0.8",
    "@std/cli": "jsr:@std/cli@^1.0.6",
    "@std/tar": "jsr:@std/tar@^0.1.3",
    "@std/assert": "jsr:@std/assert@^1.0.7",
    "@std/testing": "jsr:@std/testing@^1.0.9",
    "fflate": "npm:fflate@^0.8.2"
  }
}
