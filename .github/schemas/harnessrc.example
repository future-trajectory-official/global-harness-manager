{
  "version": "1",
  "issueTemplate": {
    "path": ".github/ISSUE_TEMPLATE/pbi.md"
  },
  "projects": {
    "productBacklog": 8,
    "sprintBoard": 9
  },
  "milestone": {
    "template": "Sprint {number}"
  },
  "customFields": {
    "type": "harness-type",
    "size": "harness-size",
    "status": "harness-status",
    "sequence": "harness-sequence",
    "effort": "harness-effort"
  },
  "harness-type": {
    "options": ["Epic", "Feature", "PBI", "WP", "Review", "Reflection"]
  }
}
