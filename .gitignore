# global-harness-manager: .gitignore

# バイナリと展開済みディレクトリ
/bin/
*.tar.gz
*.zip

# ローカル設定 (config ディレクトリ全体を除外し、.example のみ追跡)
/config/*
!/config/*.example

# ログと一時ファイル
*.log
/tmp/
/.local/*
!/.local/.gitkeep
/.session/*
!/.session/.gitkeep
/AGENTS.md
/cov_profile/
/coverage/

# 生成されるProject V2構成（他リポジトリに配布不可）
.agents/skills/bundles/workspace-bundle/setup-github-projects/references/projects-config.json


# OS/エディタ固有のファイル
.DS_Store
.vscode/
.idea/
