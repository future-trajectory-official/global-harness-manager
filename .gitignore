# global-harness-manager: .gitignore

# バイナリと展開済みディレクトリ
/bin/
*.tar.gz
*.zip

# ローカル設定 (config ディレクトリ全体を除外し、.example のみ追跡)
/config/*
!/config/*.example

# OpenCode プロジェクト設定 (ルート実体はユーザーローカル、配布は config/opencode.json.example)
/opencode.json
/opencode.jsonc

# ログと一時ファイル
*.log
/tmp/
/.local/*
!/.local/.gitkeep
/.session/*
!/.session/.gitkeep
/AGENTS.md
/cov_profile/
/coverage/


# OS/エディタ固有のファイル
.DS_Store
.vscode/
.idea/
